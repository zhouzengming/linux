# FV04 (QCS8550 / A8550PF1 / A8550BF1) board fragment
# Usage: make ARCH=arm64 qcom_fv_defconfig fv04.config
CONFIG_LOCALVERSION="-fv04"
# CONFIG_LOCALVERSION_AUTO is not set

# Core Kalama / QCS8550 SoC & boot-critical drivers (built-in for skip_initramfs direct UFS root)
CONFIG_ARM_SMMU_V3=y
CONFIG_PINCTRL_SM8550=y
CONFIG_PINCTRL_SM8550_LPASS_LPI=m
CONFIG_SM_GCC_8550=y
CONFIG_SM_TCSRCC_8550=y
CONFIG_SM_DISPCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_VIDEOCC_8550=m
CONFIG_SM_CAMCC_8550=m
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_STORAGE=m
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Gunyah hypervisor watchdog & warm-reset (bootloader / recovery / EDL) support
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_POWER_RESET_FV01_WARM=y

# Persistent crash / UART-less boot console diagnostics (pstore / ramoops)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_FTRACE=y

# Carrier power, PWM fan (TLMM GPIO9 PWM + GPIO43 power), RTC, LEDs & Type-C
CONFIG_PCI_PWRCTRL_FV01_M2=y
CONFIG_PCI_PWRCTRL_TC9563=m
CONFIG_PWM_GPIO=y
CONFIG_SENSORS_PWM_FAN=y
CONFIG_RTC_DRV_S35390A=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_ADC5_GEN3=y
CONFIG_LEDS_QCOM_LPG=m
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_UCSI_PMIC_GLINK=y

# Remoteproc, PD-mapper, Wi-Fi 7 (WCN7850) & Bluetooth 5.3
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PD_MAPPER=y
CONFIG_POWER_SEQUENCING=m
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_ATH11K=m
CONFIG_ATH12K=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# Display (DSI1 -> LT9611 HDMI-OUT + Type-C DP), HDMI-IN (LT6911C -> CAMSS), VPU (Iris Gen2) & Audio
CONFIG_DRM_MSM=m
CONFIG_DRM_LONTIUM_LT9611=m
CONFIG_VIDEO_FV01_LT6911C=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_WCD938X_SDW=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m

# PCIe1 Switch Endpoints: NVMe, Renesas USB3, Toshiba TC956x MAC0 + QCA8337 4x GbE DSA + RJ45 LEDs
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_XHCI_PCI_RENESAS=m
CONFIG_TC956X_NET=m
CONFIG_TC956X_PF=y
CONFIG_NET_DSA_QCA8K=m
CONFIG_NET_DSA_QCA8K_LEDS_SUPPORT=y
CONFIG_LEDS_TRIGGER_NETDEV=m
CONFIG_QCA83XX_PHY=m

# USB ConfigFS Composite Gadget (CDC-NCM usb0 + ADB FunctionFS + CDC-ACM ttyGS0)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# Dynamic DT overlays, filesystems, zswap/zram & MGLRU
CONFIG_MODULE_UNLOAD=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=m
CONFIG_BTRFS_FS=m
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SWAP=y
CONFIG_ZSWAP=y
# CONFIG_ZSWAP_DEFAULT_ON is not set
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Core HID, Bluetooth profiles, Virtio/KVM & optional CoreSight/EUD modules
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_HID=y
CONFIG_UHID=y
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_USB_HID=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_UDMABUF=y
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_MACVTAP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_SND_HRTIMER=m
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_MMIO=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_VFIO=m
CONFIG_VFIO_PLATFORM=m
CONFIG_USB_QCOM_EUD=m

# ============================================================================
# Robotics AI Dev Board + Daily Linux Workstation Profile (Synced with FV01 v25)
# ============================================================================

# Timers, tickless idle, heterogeneous big.LITTLE scheduling & AI memory
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_ENERGY_MODEL=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_COMPACTION=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_KSM=y
CONFIG_USERFAULTFD=y

# eBPF JIT & kernel tracing/profiling
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# ROS 2 DDS / mDNS multicast, Docker/Podman/UFW/br-lan-nat networking, VPN & BBR
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_DUMMY=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REDIR=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_NET_UDP_TUNNEL=m
CONFIG_WIREGUARD=m
CONFIG_PPP=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_MPPE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
