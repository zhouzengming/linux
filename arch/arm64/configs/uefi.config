# UEFI / ACPI dual-mode boot fragment
# Usage: make ARCH=arm64 qcom_fv_defconfig fv01.config uefi.config
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_DMI=y
CONFIG_ACPI=y
CONFIG_ACPI_SPCR_TABLE=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
