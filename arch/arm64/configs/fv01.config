# Built-in early-boot firmware for rootwait/no-initramfs boot (QUPv3 SE, Renesas xHCI, cfg80211)
CONFIG_EXTRA_FIRMWARE="qcom/qcs6490/qupv3fw.elf qcom/a660_sqe.fw qcom/a660_gmu.bin renesas_usb_fw.mem regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
