CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_INET_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m
CONFIG_POWER_RESET_FV01_WARM=y
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_QCOM_PAS_TEE=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_MMIO=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
