# FV01 (QCS6490 / A6490PF1) board fragment
# Usage: make ARCH=arm64 qcom_fv_defconfig fv01.config
CONFIG_LOCALVERSION="-fv01"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_FV01_FAN=y
CONFIG_FV01_HH_WDT=y
CONFIG_PCI_PWRCTRL_FV01_M2=y
CONFIG_REGULATOR_FV01_PCIE_POWER=m
CONFIG_VIDEO_FV01_LT6911C=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_MODULE_UNLOAD=y
CONFIG_TC956X_NET=m
CONFIG_TC956X_PF=y
CONFIG_NET_DSA_QCA8K=m
CONFIG_QCA83XX_PHY=m
CONFIG_OF_OVERLAY=y
CONFIG_BTRFS_FS=m
