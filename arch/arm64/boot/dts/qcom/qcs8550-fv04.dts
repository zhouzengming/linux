// SPDX-License-Identifier: BSD-3-Clause
/*
 * Device Tree for FV04 (A8550PF1 / A8550BF1) based on Qualcomm QCS8550.
 */
/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8550.dtsi"
#include "pm8550.dtsi"
#include "pm8550b.dtsi"
#define PMK8550VE_SID 5
#include "pm8550ve.dtsi"
#include "pm8550vs.dtsi"
#include "pmk8550.dtsi"
#include "qcom-fv-common.dtsi"

/ {
	model = "FAIOT FV04 (A8550PF1 / QCS8550)";
	compatible = "faiot,fv04", "qcom,qcs8550", "qcom,sm8550";

	aliases {
		serial0 = &uart7;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&uart7 {
	status = "okay";
};
