			link-name = "MultiMedia3";

			cpu {
				sound-dai = <0x9111 0x02>;
			};
		};

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <0x9110 0x71>;
			};

			codec {
				sound-dai = <0x9117 0x00 0x9113 0x00 0xd3 0x00>;
			};

			platform {
				sound-dai = <0x9112>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <0x9110 0x78>;
			};

			codec {
				sound-dai = <0x9117 0x01 0x9115 0x00 0xd8 0x00>;
			};

			platform {
				sound-dai = <0x9112>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <0x9110 0x6e>;
			};

			codec {
				sound-dai = <0xd2 0x00>;
			};

			platform {
				sound-dai = <0x9112>;
			};
		};
	};

	usb1-sbu-mux {
		compatible = "pericom,pi3usb102\0gpio-sbu-mux";
		enable-gpios = <0xc3 0x8e 0x01>;
		select-gpios = <0xc3 0x8d 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x9201>;
		mode-switch;
		orientation-switch;

		port {

			endpoint {
				remote-endpoint = <0x9206>;
				phandle = <0x9203>;
			};
		};
	};

	m2-power-ctrl {
		compatible = "faiot,fv01-m2-power-ctrl";
		power-enable-gpios = <0x163 0x01 0x00>;
		wwan-disable-gpios = <0x163 0x02 0x00>;
		reset-gpios = <0x163 0x03 0x00>;
		tc9563-i2c = <0x7000 0x77>;
	};

	pmic-glink {
		compatible = "qcom,qcm6490-pmic-glink\0qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x9202>;
		orientation-gpios = <0xc3 0x8c 0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			label = "USB-C";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x9207>;
						phandle = <0x9204>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x9208>;
						phandle = <0x9205>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x9203>;
						phandle = <0x9206>;
					};
				};
			};
		};
	};

