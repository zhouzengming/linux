/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "FAIOT FV01 QCS6490 (incomplete local mainline port)";
	compatible = "faiot,fv01\0qcom,qcm6490";
	chassis-type = "embedded";
	qcom,msm-id = <0x1f2 0x10000>;
	qcom,board-id = <0x10120 0x00>;

	fv01-pcie-supply-group {
		phandle = <0x8210>;
		usb-reset-gpios = <0xc3 0x8a 0x00>;
		ethernet-power-gpios = <0xc3 0x84 0x00>;
		io-gpios = <0xc3 0x83 0x00>;
		core-gpios = <0xc3 0x2c 0x00>;
		dc-in-gpios = <0xc3 0x0d 0x00>;
		pinctrl-0 = <0x820f>;
		pinctrl-names = "default";
		regulator-always-on;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "fv01_pcie1_supply_group";
		compatible = "faiot,fv01-pcie-supply-group";
	};

	fv01-wcn6855-pmu {
		vddpcie1p9-supply = <0x171>;
		vddpcie1p3-supply = <0x170>;
		vddrfa1p9-supply = <0x171>;
		vddrfa1p3-supply = <0x170>;
		vddrfa0p95-supply = <0x16d>;
		vddpmucx-supply = <0x16d>;
		vddpmumx-supply = <0x16d>;
		vddpmu-supply = <0x16d>;
		vddaon-supply = <0x16d>;
		vddio-supply = <0x7004>;
		wlan-enable-gpios = <0xc3 0x54 0x00>;
		bt-enable-gpios = <0xc3 0x55 0x00>;
		pinctrl-0 = <0x8102 0x8110>;
		pinctrl-names = "default";
		compatible = "qcom,wcn6855-pmu";

		regulators {

			ldo9 {
				phandle = <0x810c>;
				regulator-name = "fv01_wcn_rfa_1p7";
			};

			ldo8 {
				phandle = <0x810b>;
				regulator-name = "fv01_wcn_rfa_1p2";
			};

			ldo7 {
				phandle = <0x810a>;
				regulator-name = "fv01_wcn_rfa_0p8";
			};

			ldo6 {
				phandle = <0x8109>;
				regulator-name = "fv01_wcn_pcie_0p9";
			};

			ldo5 {
				phandle = <0x8108>;
				regulator-name = "fv01_wcn_pcie_1p8";
			};

			ldo4 {
				phandle = <0x8107>;
				regulator-name = "fv01_wcn_btcmx_0p8";
			};

			ldo3 {
				phandle = <0x8106>;
				regulator-name = "fv01_wcn_wlmx_0p8";
			};

			ldo2 {
				phandle = <0x8105>;
				regulator-name = "fv01_wcn_wlcx_0p8";
			};

			ldo1 {
				phandle = <0x8104>;
				regulator-name = "fv01_wcn_aon_0p8";
			};

			ldo0 {
				phandle = <0x8103>;
				regulator-name = "fv01_wcn_rfa_cmn_0p8";
			};
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		i2c0 = "/soc@0/geniqup@9c0000/i2c@980000";
		i2c1 = "/soc@0/geniqup@9c0000/i2c@984000";
		i2c2 = "/soc@0/geniqup@9c0000/i2c@988000";
		i2c3 = "/soc@0/geniqup@9c0000/i2c@98c000";
		i2c4 = "/soc@0/geniqup@9c0000/i2c@990000";
		i2c5 = "/soc@0/geniqup@9c0000/i2c@994000";
		i2c6 = "/soc@0/geniqup@9c0000/i2c@998000";
		i2c7 = "/soc@0/geniqup@9c0000/i2c@99c000";
		i2c8 = "/soc@0/geniqup@ac0000/i2c@a80000";
		i2c9 = "/soc@0/geniqup@ac0000/i2c@a84000";
		i2c10 = "/soc@0/geniqup@ac0000/i2c@a88000";
		i2c11 = "/soc@0/geniqup@ac0000/i2c@a8c000";
		i2c12 = "/soc@0/geniqup@ac0000/i2c@a90000";
		i2c13 = "/soc@0/geniqup@ac0000/i2c@a94000";
		i2c14 = "/soc@0/geniqup@ac0000/i2c@a98000";
		i2c15 = "/soc@0/geniqup@ac0000/i2c@a9c000";
		mmc1 = "/soc@0/mmc@7c4000";
		mmc2 = "/soc@0/mmc@8804000";
		spi0 = "/soc@0/geniqup@9c0000/spi@980000";
		spi1 = "/soc@0/geniqup@9c0000/spi@984000";
		spi2 = "/soc@0/geniqup@9c0000/spi@988000";
		spi3 = "/soc@0/geniqup@9c0000/spi@98c000";
		spi4 = "/soc@0/geniqup@9c0000/spi@990000";
		spi5 = "/soc@0/geniqup@9c0000/spi@994000";
		spi6 = "/soc@0/geniqup@9c0000/spi@998000";
		spi7 = "/soc@0/geniqup@9c0000/spi@99c000";
		spi8 = "/soc@0/geniqup@ac0000/spi@a80000";
		spi9 = "/soc@0/geniqup@ac0000/spi@a84000";
		spi10 = "/soc@0/geniqup@ac0000/spi@a88000";
		spi11 = "/soc@0/geniqup@ac0000/spi@a8c000";
		spi12 = "/soc@0/geniqup@ac0000/spi@a90000";
		spi13 = "/soc@0/geniqup@ac0000/spi@a94000";
		spi14 = "/soc@0/geniqup@ac0000/spi@a98000";
		spi15 = "/soc@0/geniqup@ac0000/spi@a9c000";
		serial0 = "/soc@0/geniqup@9c0000/serial@994000";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x493e000>;
			#clock-cells = <0x00>;
			phandle = <0x16b>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7ffc>;
			#clock-cells = <0x00>;
			phandle = <0x35>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan-ce@4cd000 {
			no-map;
			reg = <0x00 0x4cd000 0x00 0x1000>;
			phandle = <0xbc>;
		};

		hyp@80000000 {
			reg = <0x00 0x80000000 0x00 0x600000>;
			no-map;
		};

		smem@80900000 {
			reg = <0x00 0x80900000 0x00 0x200000>;
			no-map;
			phandle = <0x25>;
		};

		wlan-fw@80c00000 {
			reg = <0x00 0x80c00000 0x00 0xc00000>;
			no-map;
			phandle = <0xbb>;
		};

		adsp@86700000 {
			reg = <0x00 0x86700000 0x00 0x2800000>;
			no-map;
			phandle = <0x134>;
		};

		cdsp@88f00000 {
			reg = <0x00 0x88f00000 0x00 0x1e00000>;
			no-map;
			phandle = <0x13f>;
		};

		ipa-fw@8b700000 {
			reg = <0x00 0x8b700000 0x00 0x10000>;
			no-map;
			phandle = <0xcd>;
		};

		mpss@8b800000 {
			reg = <0x00 0x8b800000 0x00 0xf600000>;
			no-map;
			phandle = <0xed>;
		};

		adsp-rpc-remote-heap {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x80000000 0x00 0x80000000>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0x136>;
		};

		xbl-aop-mem@80700000 {
			no-map;
			reg = <0x00 0x80700000 0x00 0x160000>;
		};

		cmd-db@80860000 {
			compatible = "qcom,cmd-db";
			no-map;
			reg = <0x00 0x80860000 0x00 0x20000>;
		};

		reserved-xbl-uefi@80880000 {
			no-map;
			reg = <0x00 0x80880000 0x00 0x14000>;
		};

		secdata-apss@808ff000 {
			no-map;
			reg = <0x00 0x808ff000 0x00 0x1000>;
		};

		fw@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
		};

		cdsp-secure-heap@81800000 {
			no-map;
			reg = <0x00 0x81800000 0x00 0x1e00000>;
		};

		camera@86200000 {
			no-map;
			reg = <0x00 0x86200000 0x00 0x500000>;
		};

		adsp-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
		};

		video@8ad00000 {
			no-map;
			reg = <0x00 0x8ad00000 0x00 0x500000>;
			phandle = <0x146>;
		};

		cvp@8b200000 {
			phandle = <0x9007>;
			no-map;
			reg = <0x00 0x8b200000 0x00 0x500000>;
		};

		ipa-gsi@8b710000 {
			no-map;
			reg = <0x00 0x8b710000 0x00 0xa000>;
		};

		gpu-micro-code@8b71a000 {
			no-map;
			reg = <0x00 0x8b71a000 0x00 0x2000>;
			phandle = <0xe9>;
		};

		wlan@9ae00000 {
			no-map;
			reg = <0x00 0x9ae00000 0x00 0x1900000>;
			phandle = <0x138>;
		};

		removed-region@c0000000 {
			no-map;
			reg = <0x00 0xc0000000 0x00 0x5100000>;
		};

		pil-trustedvm-region@d0800000 {
			no-map;
			reg = <0x00 0xd0800000 0x00 0x76f7000>;
		};

		qrtr-shmem@d7ef7000 {
			no-map;
			reg = <0x00 0xd7ef7000 0x00 0x9000>;
		};

		neuron-block@d7f00000 {
			no-map;
			reg = <0x00 0xd7f00000 0x00 0x80000>;
		};

		neuron-block@d7f80000 {
			no-map;
			reg = <0x00 0xd7f80000 0x00 0x80000>;
		};

		user-contig-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
		};

		qseecom-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
		};

		non-secure-display-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x6400000>;
		};

		qseecom-ta-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
		};

		secure-display-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x8c00000>;
		};

		ramoops@a9000000 {
			compatible = "ramoops";
			reg = <0x00 0xa9000000 0x00 0x200000>;
			pmsg-size = <0x200000>;
			mem-type = <0x02>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
		};

		mem-dump-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x2c00000>;
		};

		audio-cma-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
		};

		splash-region@e1000000 {
			reg = <0x00 0xe1000000 0x00 0x2300000>;
			label = "cont_splash_region";
		};

		dfps-data-memory@e3300000 {
			reg = <0x00 0xe3300000 0x00 0x100000>;
			label = "dfps_data_memory";
		};

		memshare-region {
			compatible = "shared-dma-pool";
			no-map;
			alloc-ranges = <0x00 0x00 0x00 0xdfffffff>;
			alignment = <0x00 0x100000>;
			size = <0x00 0x800000>;
		};

		cnss-wlan-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x03>;
			power-domain-names = "psci";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x04>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x09>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0a>;
			power-domain-names = "psci";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0b>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0c>;
			power-domain-names = "psci";
			next-level-cache = <0x0d>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0d>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0e>;
			power-domain-names = "psci";
			next-level-cache = <0x0f>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0f>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x10>;
			power-domain-names = "psci";
			next-level-cache = <0x11>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x11>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x13>;
			power-domain-names = "psci";
			next-level-cache = <0x14>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1f>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x14>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x15>;
			power-domain-names = "psci";
			next-level-cache = <0x16>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x20>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x16>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			clocks = <0x02 0x02>;
			enable-method = "psci";
			power-domains = <0x17>;
			power-domain-names = "psci";
			next-level-cache = <0x18>;
			operating-points-v2 = <0x19>;
			capacity-dmips-mhz = <0x7c1>;
			dynamic-power-coefficient = <0x228>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x02>;
			#cooling-cells = <0x02>;
			phandle = <0x21>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x18>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1a>;
				};

				core1 {
					cpu = <0x1b>;
				};

				core2 {
					cpu = <0x1c>;
				};

				core3 {
					cpu = <0x1d>;
				};

				core4 {
					cpu = <0x1e>;
				};

				core5 {
					cpu = <0x1f>;
				};

				core6 {
					cpu = <0x20>;
				};

				core7 {
					cpu = <0x21>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "little-power-down";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x225>;
				exit-latency-us = <0x385>;
				min-residency-us = <0x6ee>;
				local-timer-stop;
				phandle = <0x29>;
			};

			cpu-sleep-0-1 {
