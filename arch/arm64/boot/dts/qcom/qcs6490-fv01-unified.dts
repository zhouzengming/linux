	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x198>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	faiot-fan {
		compatible = "faiot,fv01-fan";
		pwms = <0x199 0x03 0xf4240>;
		power-gpios = <0xc3 0x52 0x00>;
		#cooling-cells = <0x02>;
		pinctrl-names = "default";
		pinctrl-0 = <0x19a>;
		phandle = <0x194>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		phandle = <0x16c>;
	};

	lt9611-vdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "lt9611_vdd";
		vin-supply = <0x16c>;
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		gpio = <0xc3 0x3d 0x00>;
		enable-active-high;
		phandle = <0x9101>;
	};

	lt9611-vcc-regulator {
		compatible = "regulator-fixed";
		regulator-name = "lt9611_vcc";
		vin-supply = <0x16c>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0xc3 0x3c 0x00>;
		enable-active-high;
		phandle = <0x9102>;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x9105>;
				phandle = <0x9106>;
			};
		};
	};

	audio-codec {
		compatible = "qcom,wcd9385-codec";
		pinctrl-names = "default";
		pinctrl-0 = <0x9118>;
		reset-gpios = <0xc3 0x53 0x01>;
		qcom,rx-device = <0x9114>;
		qcom,tx-device = <0x9116>;
		vdd-rxtx-supply = <0x7001>;
		vdd-io-supply = <0x7001>;
		vdd-buck-supply = <0x7002>;
		vdd-mic-bias-supply = <0x16e>;
		qcom,micbias1-microvolt = <0x1b7740>;
		qcom,micbias2-microvolt = <0x1b7740>;
		qcom,micbias3-microvolt = <0x1b7740>;
		qcom,micbias4-microvolt = <0x1b7740>;
		qcom,mbhc-buttons-vthreshold-microvolt = <0x124f8 0x249f0 0x39de8 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120>;
		qcom,mbhc-headset-vthreshold-microvolt = <0x19f0a0>;
		qcom,mbhc-headphone-vthreshold-microvolt = <0xc350>;
		#sound-dai-cells = <0x01>;
		phandle = <0x9117>;
	};

	sound {
		compatible = "qcom,sm8250-sndcard";
		model = "QCS6490-FV01";
		audio-routing = "IN1_HPHL\0HPHL_OUT\0IN2_HPHR\0HPHR_OUT\0AMIC1\0MIC BIAS1\0AMIC2\0MIC BIAS2\0AMIC3\0MIC BIAS3\0AMIC4\0MIC BIAS3\0AMIC5\0MIC BIAS4\0TX SWR_ADC0\0ADC1_OUTPUT\0TX SWR_ADC1\0ADC2_OUTPUT\0TX SWR_ADC2\0ADC3_OUTPUT\0TX SWR_ADC3\0ADC4_OUTPUT\0TX SWR_DMIC0\0DMIC1_OUTPUT\0TX SWR_DMIC1\0DMIC2_OUTPUT\0TX SWR_DMIC2\0DMIC3_OUTPUT\0TX SWR_DMIC3\0DMIC4_OUTPUT\0TX SWR_DMIC4\0DMIC5_OUTPUT\0TX SWR_DMIC5\0DMIC6_OUTPUT\0TX SWR_DMIC6\0DMIC7_OUTPUT\0TX SWR_DMIC7\0DMIC8_OUTPUT";

		mm1-dai-link {
