/dts-v1/;
/plugin/;

/*
 * FV01 22-Pin RPi MIPI DSI Display + Touch Overlay (Port 1)
 * Mutually exclusive with onboard HDMI-OUT (lt9611@39) on mdss_dsi0:
 * - Disables lt9611@39 HDMI-OUT bridge.
 * - Enables i2c13 (QUP1_SE5 @ 0xa94000, GPIO 52/53) with RPi 7" MCU @ 0x45 and
 *   FocalTech FT5406 touch @ 0x38 (GPIO 0 reset, GPIO 1 IRQ).
 * - Attaches 2-lane DSI panel@0 (GPIO 43 reset) to mdss_dsi0 port@1.
 */

&lt9611 {
	status = "disabled";
};

&i2c13 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	status = "okay";

	rpi_panel_reg: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
	};

	ft5406_ts: touchscreen@38 {
		compatible = "edt,edt-ft5406";
		reg = <0x38>;
		interrupts-extended = <&fv01_tlmm 1 2>;
		reset-gpios = <&fv01_tlmm 0 1>;
	};
};

&fv01_dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "ilitek,ili9881c";
		reg = <0>;
		reset-gpios = <&fv01_tlmm 43 1>;

		port {
			rpi_panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};

	ports {
		port@1 {
			endpoint {
				remote-endpoint = <&rpi_panel_in>;
				data-lanes = <0 1>;
			};
		};
	};
};
