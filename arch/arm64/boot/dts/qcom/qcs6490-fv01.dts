// SPDX-License-Identifier: BSD-3-Clause
/* FV01 local port, work in progress. DO NOT FLASH.
 * This is a board-specific core/fan port, not full hardware coverage.
 * Unported peripherals are recorded in hardware-coverage.md.
 */
/dts-v1/;
#define PM7250B_SID 8
#define PM7250B_SID1 9
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "kodiak.dtsi"
#include "qcs6490-audioreach.dtsi"
#include "pm7250b.dtsi"
#include "pm7325.dtsi"
#include "pm8350c.dtsi"
#include "pmk8350.dtsi"
#include "pmr735a.dtsi"
#include "fv01-memory.dtsi"
#include "fv01-regulators.dtsi"
#include "qcom-fv-common.dtsi"

/ {
	model = "FAIOT FV01 QCS6490 (incomplete local mainline port)";
	compatible = "faiot,fv01", "qcom,qcm6490";
	chassis-type = "embedded";
	/* Retained solely for future Qualcomm bootloader selection, not an overlay. */
	qcom,msm-id = <498 65536>;
	qcom,board-id = <65824 0>;

	aliases { serial0 = &uart5; };
	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* The upstream SoC bus is soc@0. Discover this platform driver in
	 * userspace instead of assuming the factory /soc/... sysfs path.
	 */
	fv01_fan: faiot-fan {
		compatible = "faiot,fv01-fan";
		pwms = <&pm8350c_pwm 3 1000000>;
		power-gpios = <&tlmm 82 GPIO_ACTIVE_HIGH>;
		#cooling-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&fv01_fan_pwm>;
	};

	/* Exact live DDR banks. Bootloader memory fixups remain to be verified. */
	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x39300000>,
		      <1 0x80000000 1 0>,
		      <0 0xc0000000 0 0xc0000000>;
	};


	thermal-zones {
		fv01-fan-thermal {
			thermal-sensors = <&tsens0 2>;
			polling-delay-passive = <20>;
			polling-delay = <1000>;
			trips {
				fv01_fan_cold: fan-cold {
					temperature = <30000>;
					hysteresis = <1000>;
					type = "active";
				};
				fv01_fan_warm: fan-warm {
					temperature = <35000>;
					hysteresis = <1000>;
					type = "active";
				};
				fv01_fan_hot: fan-hot {
					temperature = <45000>;
					hysteresis = <1000>;
					type = "active";
				};
				fv01_fan_max: fan-max {
					temperature = <55000>;
					hysteresis = <1000>;
					type = "active";
				};
			};
			cooling-maps {
				map0 { trip = <&fv01_fan_cold>; cooling-device = <&fv01_fan 0 0>; };
				map1 { trip = <&fv01_fan_warm>; cooling-device = <&fv01_fan 1 1>; };
				map2 { trip = <&fv01_fan_hot>; cooling-device = <&fv01_fan 2 2>; };
				map3 { trip = <&fv01_fan_max>; cooling-device = <&fv01_fan 3 3>; };
			};
		};
	};
};

&pm8350c_gpios {
	fv01_fan_pwm: fan-pwm-state {
		pins = "gpio8";
		function = PMIC_GPIO_FUNC_FUNC1;
		power-source = <0>;
		bias-disable;
		output-low;
		drive-push-pull;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
	};
};

&pm8350c_pwm {
	status = "okay";
	/* PWM channel 3 is independent of the SDAM pattern sequencer. */
};

&uart5 { status = "okay"; };
&qupv3_id_0 { status = "okay"; };
&qupv3_id_1 { status = "okay"; };
&gpi_dma0 { status = "okay"; };
&gpi_dma1 { status = "okay"; };

&i2c1 {
	clock-frequency = <100000>;
	status = "okay";
	rtc@30 { compatible = "sii,s35390a"; reg = <0x30>; };
	/* @08/@09 PM8008, @22/@23 TCA6424, @2b LT6911C, @39 LT9611,
	 * and @77 PCIe management need individual binding and sequencing ports.
	 * Do not instantiate a guessed LT9611UXC or a QPS615 reference-board graph.
	 */
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 175 GPIO_ACTIVE_LOW>;
	vcc-supply = <&vreg_l7b_2p952>;
	vcc-max-microamp = <800000>;
	vccq-supply = <&vreg_l9b_1p2>;
	vccq-max-microamp = <900000>;
	status = "okay";
};
&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l10c_0p88>;
	vdda-pll-supply = <&vreg_l6b_1p2>;
	status = "okay";
};

&usb_1_hsphy {
	vdda-pll-supply = <&vreg_l10c_0p88>;
	vdda33-supply = <&vreg_l2b_3p072>;
	vdda18-supply = <&vreg_l1c_1p8>;
	status = "okay";
};
&usb_1 {
	/* First bring-up uses USB2 peripheral only; Type-C/SS redriver is pending. */
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	/delete-property/ phys;
	/delete-property/ phy-names;
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	status = "okay";
};

&gpu { status = "okay"; };
&gpu_zap_shader { firmware-name = "qcom/fv01/a660_zap.elf"; };

/* Enable the DRM component master so the Adreno GPU can expose a render node.
 * The DSI/DP outputs remain disabled until their board-specific graphs are
 * validated, but MDSS+DPU are needed for the MSM component bind. */
&mdss { status = "okay"; };

&remoteproc_cdsp {
	firmware-name = "qcom/fv01/cdsp.mdt";
	/* Kept disabled until PAS and firmware provenance checks are complete. */
	status = "disabled";
};
&remoteproc_adsp { status = "disabled"; };
&remoteproc_mpss { status = "disabled"; };
&remoteproc_wpss { status = "disabled"; };
&wifi { status = "disabled"; }; /* FV01 uses PCIe 17cb:1103, not RB3 WCN6750. */
